# Copy to .env.local and fill in real values. Never commit .env.local.
# Local development uses the local Supabase stack: run `npx supabase start`,
# then copy API_URL, PUBLISHABLE_KEY and SECRET_KEY from `npx supabase status`.
# Production values live in Vercel.

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Bypasses RLS. Never expose this in client-side code.
SUPABASE_SECRET_KEY=sb_secret_xxx

NEXT_PUBLIC_SITE_URL=http://localhost:3100

RESEND_API_KEY=re_xxx

# HMAC key for signing finalized letter PDFs and the /view/[token] cookie.
# Any random string of 32+ characters. Use a different value per environment.
# Changing it makes signatures on letters finalized before the change fail verification.
PDF_SIGNING_SECRET=a-long-random-string

# Bearer token for /api/cron/cleanup. The route rejects every call while it is unset.
CRON_SECRET=a-long-random-string

STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Read by the code, not yet in .env.local ---
# Inbox that receives contact form messages.
STAFF_EMAIL=staff@example.com
# Contact email sent to the OpenAlex API for university search.
OPENALEX_MAILTO=you@example.com

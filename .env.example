# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Bypasses RLS. Never expose this in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

RESEND_API_KEY=re_xxx

# HMAC key for signing finalized letter PDFs and the /view/[token] cookie.
PDF_SIGNING_SECRET=a-long-random-string

STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Read by the code, not yet in .env.local ---
# Bearer token for /api/cron/cleanup. If unset, the route accepts any caller.
CRON_SECRET=a-long-random-string
# Inbox that receives contact form messages.
STAFF_EMAIL=staff@example.com
# Contact email sent to the OpenAlex API for university search.
OPENALEX_MAILTO=you@example.com
